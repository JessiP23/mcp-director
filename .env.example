# director-cut backend (your Tauri app's FastAPI)
DIRECTOR_BASE_URL=http://localhost:9420

# OAuth / Auth
JWT_SECRET=change-me-32-chars-minimum
JWT_ALGORITHM=HS256
TOKEN_TTL_SECONDS=3600

# Supabase (mirror from director-cut for token validation)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_OAUTH_PROVIDER=google

# Redis (for job state & session store — optional locally, required in prod)
REDIS_URL=redis://localhost:6379/0

# Server
MCP_HOST=0.0.0.0
MCP_PORT=8080
MCP_BASE_URL=https://your-director-mcp.com

# Environment
ENVIRONMENT=development
ENFORCE_HTTPS=false

# Rate limiting
RATE_LIMIT_CALLS_PER_MINUTE=60
