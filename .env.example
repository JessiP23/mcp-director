DIRECTOR_BASE_URL=http://127.0.0.1:9420
# Optional dev-only: Supabase access JWT for director-cut when the MCP client uses a minted
# test JWT (not the OAuth access token). Only read when ENVIRONMENT=development. OAuth
# logins pair Supabase access with the MCP token in Redis — leave empty in production.
DIRECTOR_BEARER_TOKEN=
MCP_BASE_URL=http://localhost:8080

# OAuth / JWT for director-mcp (not Supabase — used to sign MCP access tokens)
JWT_SECRET=change-me-32-chars-minimum
JWT_ALGORITHM=HS256
TOKEN_TTL_SECONDS=3600

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_OAUTH_PROVIDER=google

# Redis (OAuth PKCE, rate limits, token revocation). Local: redis://…
# Upstash and most hosted Redis require TLS — use rediss://… (not redis://);
# plain TCP often fails at first command with ConnectionError: Connection closed by server.
REDIS_URL=redis://localhost:6379/0

MCP_HOST=0.0.0.0
MCP_PORT=8080

ENVIRONMENT=development
ENFORCE_HTTPS=false

RATE_LIMIT_CALLS_PER_MINUTE=60
